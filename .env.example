# Avaliador de IA: "agy" para testes locais; "gemini_api" para a API direta.
AVALIADOR=agy
AGY_MODELO=gemini-3.6-flash-low
AGY_TIMEOUT_SEGUNDOS=300

# Adzuna (obrigatório para buscar vagas)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Gemini API (a chave só é obrigatória quando AVALIADOR=gemini_api)
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.6-flash
GEMINI_VAGAS_POR_LOTE=10

# Telegram (token do BotFather; o chat ID só é obrigatório quando DATABASE_URL está vazio)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Banco (string "Session pooler" do Supabase; vazio = perfil fixo, sem histórico)
DATABASE_URL=

# Radar (a Gupy não precisa de chave)
FONTES=adzuna,gupy
DIAS_RECENTES=5
QUANTIDADE_VAGAS_ENVIADAS=5
